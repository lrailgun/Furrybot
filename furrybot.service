[Unit]
Description=Furrybot Discord service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=furrybot
Group=furrybot
WorkingDirectory=/opt/furrybot
ExecStart=/opt/furrybot/.venvs/current/bin/python /opt/furrybot/bot.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/furrybot

[Install]
WantedBy=multi-user.target
